---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research', ({ data }) => !data.draft);
const allThoughts = await getCollection('thoughts', ({ data }) => !data.draft);

const tagMap = new Map<string, number>();

[...allResearch, ...allThoughts].forEach((item) => {
  item.data.tags.forEach((tag) => {
    const formatted = tag.trim();
    tagMap.set(formatted, (tagMap.get(formatted) || 0) + 1);
  });
});

const sortedTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Topics & Philosophical Taxonomy">
  <div class="mb-10 pb-6 border-b border-[var(--border-subtle)]">
    <div class="flex items-center gap-2 text-xs font-sans font-semibold uppercase tracking-wider text-[var(--accent-primary)] mb-2">
      <span>Taxonomy &amp; Index</span> • <span>{sortedTags.length} Subject Areas</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)] mb-3">
      Topic Taxonomy
    </h1>
    <p class="text-[var(--text-secondary)] font-sans leading-relaxed max-w-2xl text-base">
      Browse philosophy research publications and thought streams categorized by field, logic system, and philosophical domain.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {sortedTags.map(([tag, count]) => (
      <a
        href={`/topics/${tag.toLowerCase().replace(/\s+/g, '-')}`}
        class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--border-accent)] hover:shadow-lg transition flex items-center justify-between group"
      >
        <span class="font-serif font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition">
          #{tag}
        </span>
        <span class="px-2.5 py-1 rounded-full text-xs font-sans font-semibold bg-[var(--tag-bg)] text-[var(--accent-primary)] border border-[var(--tag-border)]">
          {count} {count === 1 ? 'publication' : 'publications'}
        </span>
      </a>
    ))}
  </div>
</BaseLayout>
