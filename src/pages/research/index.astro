---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research', ({ data }) => !data.draft);
const sortedResearch = allResearch.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = Array.from(new Set(sortedResearch.map(r => r.data.category).filter(Boolean)));
---

<BaseLayout title="Philosophy Research Papers & Publications">
  <div class="mb-10 pb-6 border-b border-[var(--border-subtle)]">
    <div class="flex items-center gap-2 text-xs font-sans font-semibold uppercase tracking-wider text-[var(--accent-primary)] mb-2">
      <span>Academic Publications</span> • <span>{sortedResearch.length} Papers</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)] mb-3">
      Philosophy Research Papers
    </h1>
    <p class="text-[var(--text-secondary)] font-sans leading-relaxed max-w-2xl text-base">
      Analytical essays, epistemology publications, philosophy of language, and intellectual history.
    </p>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-[var(--border-subtle)] font-sans text-xs">
      <span class="text-[var(--text-muted)] py-1 font-medium">Filter by Field:</span>
      <a href="/research" class="px-3 py-1 rounded-full bg-[var(--accent-subtle)] text-[var(--accent-primary)] font-semibold border border-[var(--tag-border)]">All ({sortedResearch.length})</a>
      {categories.map(cat => (
        <a
          href={`/topics/${cat.toLowerCase().replace(/\s+/g, '-')}`}
          class="px-3 py-1 rounded-full bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--accent-primary)] hover:border-[var(--border-accent)] transition border border-[var(--border-subtle)]"
        >
          {cat}
        </a>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {sortedResearch.map((item) => (
      <ArticleCard
        title={item.data.title}
        description={item.data.description}
        pubDate={item.data.pubDate}
        slug={item.slug}
        category={item.data.category}
        tags={item.data.tags}
        type="research"
      />
    ))}
  </div>
</BaseLayout>
