---
---

<div id="search-modal" class="hidden fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-16 bg-black/75 backdrop-blur-md items-start justify-center animate-fadeIn">
  <div class="relative w-full max-w-2xl bg-[var(--bg-surface)] rounded-2xl shadow-2xl border border-[var(--border-subtle)] overflow-hidden font-sans text-xs">
    
    <!-- Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--bg-surface-elevated)]">
      <svg class="w-4 h-4 mr-3 text-[var(--accent-primary)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-modal-input"
        type="text"
        placeholder="Search publications, topics, formal proofs, or keywords..."
        class="w-full bg-transparent text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none text-sm font-sans"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="flex items-center gap-1.5 ml-2">
        <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-[var(--bg-canvas)] text-[var(--text-muted)] rounded border border-[var(--border-subtle)]">ESC</kbd>
        <button id="close-search-btn" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition font-mono" aria-label="Close">
          ✕
        </button>
      </div>
    </div>

    <!-- Quick Actions & Results Container -->
    <div id="search-results" class="max-h-96 overflow-y-auto p-3 space-y-2">
      <!-- Default Quick Action Commands shown when input is empty -->
      <div id="quick-actions-section" class="space-y-3">
        <div>
          <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">
            Navigation &amp; Reading Indexes
          </div>
          <div class="space-y-1 mt-1">
            <a href="/research" class="command-item flex items-center justify-between p-2.5 rounded-xl hover:bg-[var(--accent-subtle)] transition text-[var(--text-primary)] group">
              <span class="flex items-center gap-2.5 font-medium">
                <span class="w-6 h-6 rounded-md bg-[var(--bg-canvas)] flex items-center justify-center text-[10px] font-mono text-[var(--accent-primary)] font-bold">§</span>
                <span>Philosophy Research Papers</span>
              </span>
              <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)]">Formal logic &amp; analysis →</span>
            </a>
            <a href="/thoughts" class="command-item flex items-center justify-between p-2.5 rounded-xl hover:bg-[var(--accent-subtle)] transition text-[var(--text-primary)] group">
              <span class="flex items-center gap-2.5 font-medium">
                <span class="w-6 h-6 rounded-md bg-[var(--bg-canvas)] flex items-center justify-center text-[10px] font-mono text-[var(--accent-primary)] font-bold">¶</span>
                <span>Thoughts Stream</span>
              </span>
              <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)]">Micro-reflections &amp; notes →</span>
            </a>
            <a href="/topics" class="command-item flex items-center justify-between p-2.5 rounded-xl hover:bg-[var(--accent-subtle)] transition text-[var(--text-primary)] group">
              <span class="flex items-center gap-2.5 font-medium">
                <span class="w-6 h-6 rounded-md bg-[var(--bg-canvas)] flex items-center justify-center text-[10px] font-mono text-[var(--accent-primary)] font-bold">#</span>
                <span>Topic Taxonomy</span>
              </span>
              <span class="text-[11px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)]">Browse all tags →</span>
            </a>
          </div>
        </div>

        <div class="pt-2 border-t border-[var(--border-subtle)]">
          <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">
            Instant Actions
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-1">
            <button id="cmd-random-essay" class="command-item text-left p-2.5 rounded-xl hover:bg-[var(--accent-subtle)] transition text-[var(--text-primary)] flex items-center gap-2">
              <span class="font-mono text-[var(--accent-primary)] font-bold">↻</span> <span>Ponder Random Article</span>
            </button>
            <button id="cmd-copy-rss" class="command-item text-left p-2.5 rounded-xl hover:bg-[var(--accent-subtle)] transition text-[var(--text-primary)] flex items-center gap-2">
              <span class="font-mono text-[var(--accent-primary)] font-bold">⊞</span> <span id="rss-btn-text">Copy RSS Feed URL</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Live Dynamic Search Results rendered here -->
      <div id="dynamic-search-results" class="hidden space-y-1.5"></div>
    </div>

    <!-- Command Palette Footer -->
    <div class="px-4 py-2 bg-[var(--bg-surface-elevated)] border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-muted)]">
      <div class="flex items-center gap-3">
        <span><kbd class="font-mono bg-[var(--bg-canvas)] px-1 rounded">↑↓</kbd> to navigate</span>
        <span><kbd class="font-mono bg-[var(--bg-canvas)] px-1 rounded">↵</kbd> to select</span>
      </div>
      <span class="font-serif italic">funtohard episteme search</span>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const closeBtn = document.getElementById('close-search-btn');
  const searchInput = document.getElementById('search-modal-input') as HTMLInputElement;
  const quickActionsSection = document.getElementById('quick-actions-section');
  const dynamicResults = document.getElementById('dynamic-search-results');

  const openModal = () => {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  };

  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // Close on Escape or shortcut Cmd+K / Ctrl+K
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal) {
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
    }
  });

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Quick Action: Random Essay
  const randomBtn = document.getElementById('cmd-random-essay');
  const articlesList = [
    '/research/the-horizon-of-meaning',
    '/research/philosophers-wives-fame-and-erasure',
    '/thoughts/epistemology-of-the-machine',
  ];
  if (randomBtn) {
    randomBtn.addEventListener('click', () => {
      const randomIndex = Math.floor(Math.random() * articlesList.length);
      window.location.href = articlesList[randomIndex];
    });
  }

  // Quick Action: Copy RSS
  const rssBtn = document.getElementById('cmd-copy-rss');
  const rssText = document.getElementById('rss-btn-text');
  if (rssBtn && rssText) {
    rssBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(new URL('/rss.xml', window.location.origin).href);
      rssText.innerText = '✓ RSS Feed URL Copied!';
      setTimeout(() => { rssText.innerText = 'Copy RSS Feed URL'; }, 2000);
    });
  }

  // Live Pagefind Search Handler
  let pagefind: any;
  if (searchInput && dynamicResults && quickActionsSection) {
    searchInput.addEventListener('input', async () => {
      const query = searchInput.value.toLowerCase().trim();
      
      if (!query) {
        quickActionsSection.classList.remove('hidden');
        dynamicResults.classList.add('hidden');
        dynamicResults.innerHTML = '';
        return;
      }

      quickActionsSection.classList.add('hidden');
      dynamicResults.classList.remove('hidden');

      try {
        if (!pagefind) {
          const pagefindUrl = '/pagefind/pagefind.js';
          pagefind = await import(/* @vite-ignore */ pagefindUrl);
        }
        const search = await pagefind.search(query);
        
        if (search.results.length === 0) {
          dynamicResults.innerHTML = `
            <div class="text-center py-8 text-[var(--text-muted)]">
              No publications matching "<span class="text-[var(--text-primary)] font-medium">${query}</span>" found.
            </div>
          `;
          return;
        }

        const resultsHtml = await Promise.all(
          search.results.slice(0, 7).map(async (r: any) => {
            const data = await r.data();
            return `
              <a href="${data.url}" class="block p-3 rounded-xl hover:bg-[var(--accent-subtle)] transition border border-transparent hover:border-[var(--border-accent)] group">
                <div class="font-serif font-bold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                  ${data.meta.title || 'Publication'}
                </div>
                <div class="text-[11px] text-[var(--text-secondary)] mt-1 line-clamp-2 leading-relaxed">
                  ${data.excerpt}
                </div>
              </a>
            `;
          })
        );
        dynamicResults.innerHTML = `<div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--accent-primary)]">Matching Publications (${search.results.length})</div>` + resultsHtml.join('');
      } catch (e) {
        dynamicResults.innerHTML = `
          <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Suggested Publications</div>
          <a href="/research/the-horizon-of-meaning" class="block p-3 rounded-xl hover:bg-[var(--accent-subtle)] transition border border-transparent hover:border-[var(--border-accent)]">
            <div class="font-serif font-bold text-sm text-[var(--text-primary)]">The Horizon of Meaning</div>
            <div class="text-[11px] text-[var(--text-secondary)] mt-0.5">Epistemology, Language, and Semantic Normalization</div>
          </a>
          <a href="/research/philosophers-wives-fame-and-erasure" class="block p-3 rounded-xl hover:bg-[var(--accent-subtle)] transition border border-transparent hover:border-[var(--border-accent)]">
            <div class="font-serif font-bold text-sm text-[var(--text-primary)]">Philosophers' Wives: Fame and Erasure</div>
            <div class="text-[11px] text-[var(--text-secondary)] mt-0.5">Ethics, Historical Vilification, and Feminism</div>
          </a>
          <a href="/thoughts/epistemology-of-the-machine" class="block p-3 rounded-xl hover:bg-[var(--accent-subtle)] transition border border-transparent hover:border-[var(--border-accent)]">
            <div class="font-serif font-bold text-sm text-[var(--text-primary)]">The Epistemology of the Machine</div>
            <div class="text-[11px] text-[var(--text-secondary)] mt-0.5">Systems Programming, Non-Determinism, and Undefined Behavior</div>
          </a>
        `;
      }
    });
  }
</script>
